# =============================================================================
# AIVA — Artificial Intelligence Virtual Assistant
# Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# =============================================================================

# --- Supabase Configuration ---
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database ---
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler connection string for the backend
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Ollama AI Configuration ---
# URL where Ollama is running (default: local)
OLLAMA_BASE_URL=http://localhost:11434
# Model to use (will be verified on startup)
OLLAMA_MODEL=llama3.2
# Request timeout in seconds
OLLAMA_TIMEOUT=120
# Max tokens for response
OLLAMA_MAX_TOKENS=2048

# --- Optional Cloud LLM (Free 24/7 inference via Groq without local GPU) ---
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Telegram Bot ---
# Get from: Telegram @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Secret token for webhook verification (generate a random string)
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-string
# Public URL where your backend is hosted (for webhook registration)
TELEGRAM_WEBHOOK_URL=https://your-backend-domain.com/webhooks/telegram

# --- Google OAuth (configured in Supabase) ---
# These are configured in Supabase Dashboard → Authentication → Providers → Google
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET go in Supabase, not here.
# The frontend only needs SUPABASE_URL and SUPABASE_ANON_KEY for auth.

# --- Application Settings ---
# Secret key for additional server-side signing (generate a random 64-char hex string)
APP_SECRET_KEY=your-64-char-hex-secret-key
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app
# Backend host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Max upload file size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# --- Frontend Environment Variables (in frontend/.env.local) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
